<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>__APP_NAME__</title>
<style>
:root{
--bg:#f4efe6;--ink:#15231a;--muted:#5f6f63;--surface:rgba(255,255,255,.76);--line:rgba(21,35,26,.12);
--accent:#0f766e;--accent-2:#d97706;--success:#166534;--danger:#b42318;
}
*{box-sizing:border-box}
body{margin:0;font-family:"IBM Plex Sans","PingFang SC","Microsoft YaHei",sans-serif;color:var(--ink);background:
radial-gradient(circle at top left,rgba(15,118,110,.14),transparent 34%),
radial-gradient(circle at bottom right,rgba(217,119,6,.16),transparent 30%),
linear-gradient(180deg,#f5f0e8 0%,#efe6d8 100%);min-height:100vh}
.shell{max-width:1040px;margin:0 auto;padding:48px 24px 72px}
.hero{display:grid;grid-template-columns:1.3fr .9fr;gap:22px;align-items:stretch}
.panel{background:var(--surface);backdrop-filter:blur(12px);border:1px solid var(--line);border-radius:24px;box-shadow:0 22px 80px rgba(21,35,26,.08)}
.hero-main{padding:34px}
.eyebrow{display:inline-flex;gap:10px;align-items:center;padding:8px 14px;border-radius:999px;background:rgba(15,118,110,.08);color:var(--accent);font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase}
h1{margin:18px 0 12px;font-size:clamp(34px,5vw,58px);line-height:1.02;letter-spacing:-.05em}
.subtitle{margin:0;color:var(--muted);font-size:16px;line-height:1.75;max-width:620px}
.hero-side{padding:26px;display:flex;flex-direction:column;justify-content:space-between;background:
linear-gradient(160deg,rgba(15,118,110,.92),rgba(10,53,49,.96));color:#eff8f6}
.side-title{font-size:13px;letter-spacing:.08em;text-transform:uppercase;opacity:.78}
.side-metric{font-size:46px;font-weight:800;letter-spacing:-.05em;margin:10px 0 6px}
.side-copy{margin:0;font-size:14px;line-height:1.7;opacity:.9}
.side-list{margin:18px 0 0;padding-left:18px;font-size:14px;line-height:1.8}
.workspace{display:grid;grid-template-columns:1.1fr .9fr;gap:22px;margin-top:22px}
.input-card,.result-card{padding:28px}
.section-title{margin:0 0 14px;font-size:14px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
.prompt{width:100%;min-height:220px;padding:18px 20px;border-radius:18px;border:1px solid rgba(21,35,26,.14);background:rgba(255,255,255,.88);color:var(--ink);font:inherit;line-height:1.75;resize:vertical;outline:none;transition:border-color .2s,box-shadow .2s}
.prompt:focus{border-color:rgba(15,118,110,.45);box-shadow:0 0 0 5px rgba(15,118,110,.1)}
.actions{display:flex;gap:12px;align-items:center;margin-top:16px}
.btn{border:none;border-radius:16px;padding:14px 22px;font:inherit;font-weight:700;cursor:pointer}
.btn-primary{background:linear-gradient(135deg,var(--accent),#115e59);color:#fff;box-shadow:0 16px 32px rgba(15,118,110,.2)}
.btn-secondary{background:rgba(21,35,26,.06);color:var(--ink)}
.btn:disabled{opacity:.55;cursor:not-allowed}
.status{font-size:13px;color:var(--muted)}
.result-card{display:flex;flex-direction:column;gap:18px}
.result-shell{display:none}
.result-shell.show{display:block}
.summary{padding:18px 20px;border-radius:18px;background:rgba(15,118,110,.09);border:1px solid rgba(15,118,110,.16);line-height:1.75}
.meta{display:flex;flex-wrap:wrap;gap:10px;font-size:12px;color:var(--muted)}
.chip{display:inline-flex;align-items:center;gap:8px;padding:9px 12px;border-radius:999px;background:rgba(21,35,26,.06)}
.list,.grid{display:grid;gap:10px}
.list{padding:0;margin:0;list-style:none}
.list li{padding:12px 14px;border-radius:14px;background:rgba(255,255,255,.72);border:1px solid rgba(21,35,26,.08);line-height:1.6}
.grid{grid-template-columns:repeat(auto-fit,minmax(180px,1fr))}
.card{padding:14px 16px;border-radius:16px;background:rgba(255,255,255,.72);border:1px solid rgba(21,35,26,.08)}
.card h3{margin:0 0 8px;font-size:15px}
.card p{margin:0;color:var(--muted);font-size:13px;line-height:1.65}
.download{display:inline-flex;align-items:center;gap:8px;padding:12px 16px;border-radius:14px;background:rgba(217,119,6,.12);color:#8a4b08;text-decoration:none;font-weight:700}
.raw{padding:16px;border-radius:16px;background:#1f2937;color:#e5f3ef;font-family:Consolas,monospace;font-size:12px;line-height:1.6;white-space:pre-wrap;overflow:auto;max-height:280px}
.error{display:none;padding:14px 16px;border-radius:16px;background:rgba(180,35,24,.08);color:var(--danger);border:1px solid rgba(180,35,24,.16)}
.error.show{display:block}
@media (max-width:900px){
  .hero,.workspace{grid-template-columns:1fr}
  .shell{padding:26px 16px 42px}
  .hero-main,.hero-side,.input-card,.result-card{padding:22px}
}
</style>
</head>
<body>
<div class="shell">
  <section class="hero">
    <div class="panel hero-main">
      <div class="eyebrow">Vertical App Scaffold</div>
      <h1>__APP_NAME__</h1>
      <p class="subtitle">__APP_DESCRIPTION__ 当前页面来自 Friday 的业务脚手架模板。你只需要继续修改 Skill 里的业务流程和这里的前端渲染，就能把同一个底座装配成新的垂直应用。</p>
    </div>
    <div class="panel hero-side">
      <div>
        <div class="side-title">自动装配入口</div>
        <div class="side-metric">3</div>
        <p class="side-copy">这个应用由三类文件自动发现并挂载：`skills/*.py`、`config/skills/*.json`、`static/*.html`。</p>
      </div>
      <ul class="side-list">
        <li>触发词：__APP_TRIGGER__</li>
        <li>路由：__APP_ROUTE__</li>
        <li>分组：__PROJECT_ID__</li>
      </ul>
    </div>
  </section>

  <section class="workspace">
    <div class="panel input-card">
      <h2 class="section-title">提交业务任务</h2>
      <textarea id="prompt" class="prompt" placeholder="描述你的业务诉求，例如：帮我审查这份 SaaS 合同的付款和违约条款，输出风险摘要与修改建议。"></textarea>
      <div class="actions">
        <button id="submit-btn" class="btn btn-primary" onclick="submitTask()">提交到 __APP_NAME__</button>
        <button class="btn btn-secondary" onclick="fillExample()">填充示例</button>
      </div>
      <p id="status" class="status">当前页面默认调用 `POST /api/v1/workflows`，并等待 Skill pipeline 完整返回。</p>
      <div id="error" class="error"></div>
    </div>

    <div class="panel result-card">
      <h2 class="section-title">结果渲染</h2>
      <div id="result" class="result-shell">
        <div id="summary" class="summary"></div>
        <div id="meta" class="meta"></div>
        <div>
          <h2 class="section-title">重点结论</h2>
          <ul id="highlights" class="list"></ul>
        </div>
        <div>
          <h2 class="section-title">下一步动作</h2>
          <ul id="next-actions" class="list"></ul>
        </div>
        <div>
          <h2 class="section-title">结构化明细</h2>
          <div id="findings" class="grid"></div>
        </div>
        <div id="download-wrap"></div>
        <div>
          <h2 class="section-title">原始返回</h2>
          <pre id="raw" class="raw"></pre>
        </div>
      </div>
    </div>
  </section>
</div>

<script>
const API = '/api/v1';
const SKILL_NAME = '__APP_NAME__';

function fillExample() {
  document.getElementById('prompt').value = '请根据这个业务场景输出结构化分析、重点风险和下一步建议。';
}

function setStatus(text) {
  document.getElementById('status').textContent = text;
}

function setError(text) {
  const error = document.getElementById('error');
  error.textContent = text;
  error.classList.toggle('show', Boolean(text));
}

function setLoading(loading) {
  const button = document.getElementById('submit-btn');
  button.disabled = loading;
  button.textContent = loading ? '处理中...' : '提交到 __APP_NAME__';
}

function escapeHtml(text) {
  return String(text)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

function renderStringList(targetId, items) {
  const target = document.getElementById(targetId);
  target.innerHTML = '';
  (items || []).forEach((item) => {
    const li = document.createElement('li');
    li.textContent = typeof item === 'string' ? item : JSON.stringify(item, null, 2);
    target.appendChild(li);
  });
}

function renderFindings(findings) {
  const target = document.getElementById('findings');
  target.innerHTML = '';
  (findings || []).forEach((item) => {
    const card = document.createElement('div');
    card.className = 'card';
    const title = escapeHtml(item.title || '未命名结果');
    const detail = escapeHtml(item.detail || JSON.stringify(item));
    card.innerHTML = '<h3>' + title + '</h3><p>' + detail + '</p>';
    target.appendChild(card);
  });
}

function extractPayload(response) {
  if (response && response.result && response.result.final_output && response.result.final_output.data) {
    return response.result.final_output.data;
  }
  if (response && response.result && response.result.final_output) {
    return response.result.final_output;
  }
  if (response && response.result) {
    return response.result;
  }
  return response || {};
}

function renderResult(payload, response) {
  const shell = document.getElementById('result');
  const structured = payload.structured_result || {};
  const findings = structured.findings || [];

  document.getElementById('summary').textContent = payload.summary || '任务已完成。';
  document.getElementById('meta').innerHTML = [
    response.workflow_id ? '<span class="chip">workflow: ' + escapeHtml(response.workflow_id) + '</span>' : '',
    response.degradation_level !== undefined ? '<span class="chip">degradation: ' + escapeHtml(response.degradation_level) + '</span>' : '',
    '<span class="chip">route: __APP_ROUTE__</span>'
  ].filter(Boolean).join('');

  renderStringList('highlights', payload.highlights || []);
  renderStringList('next-actions', payload.next_actions || []);
  renderFindings(findings);

  const downloadWrap = document.getElementById('download-wrap');
  downloadWrap.innerHTML = '';
  if (payload.download_url) {
    downloadWrap.innerHTML = '<a class="download" href="' + escapeHtml(payload.download_url) + '">下载交付物</a>';
  }

  document.getElementById('raw').textContent = JSON.stringify(payload, null, 2);
  shell.classList.add('show');
}

async function submitTask() {
  const prompt = document.getElementById('prompt').value.trim();
  if (!prompt) {
    setError('请输入业务任务描述。');
    return;
  }

  setError('');
  setLoading(true);
  setStatus('正在执行 __APP_NAME__ Skill pipeline...');

  try {
    const response = await fetch(API + '/workflows', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({
        task: SKILL_NAME + '：' + prompt,
        user_id: '__APP_ID___demo',
        mode: 'auto'
      })
    });

    const data = await response.json();
    if (!response.ok) {
      throw new Error(data.detail || data.message || ('HTTP ' + response.status));
    }

    const payload = extractPayload(data);
    renderResult(payload, data);
    setStatus('执行完成。你可以继续按业务需要调整 Skill 和页面。');
  } catch (error) {
    setError('提交失败：' + error.message);
    setStatus('请求失败。请检查后端依赖、模型配置或 Skill 实现。');
  } finally {
    setLoading(false);
  }
}
</script>
</body>
</html>
