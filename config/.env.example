# 星期五 (Friday) - 环境变量配置
# 复制此文件为 .env 并填入实际值

# ========== 数据库 ==========
DATABASE_URL=postgresql+asyncpg://friday:friday_secret@localhost:5432/friday
REDIS_URL=redis://localhost:6379/0

# ========== 模型 API Key ==========
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

OPENAI_API_KEY=sk-your-openai-key
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# ========== 默认模型 ==========
DEFAULT_MODEL=deepseek-chat
DEFAULT_FAST_MODEL=deepseek-chat

# ========== 沙盒 ==========
SANDBOX_TYPE=subprocess        # subprocess | docker

# ========== 日志 ==========
LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                 # json | text

# ========== 限流 (每模型) ==========
RATE_LIMIT_DEEPSEEK_RPM=500
RATE_LIMIT_OPENAI_RPM=500
RATE_LIMIT_ANTHROPIC_RPM=4000

# ========== 熔断器 ==========
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_OPEN_TIMEOUT_S=30
CIRCUIT_BREAKER_HALF_OPEN_MAX=3

# ========== 服务 ==========
HOST=0.0.0.0
PORT=8000

# ========== CORS ==========
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# ========== OpenTelemetry (可选) ==========
OTEL_EXPORTER_OTLP_ENDPOINT=

# ========== 认证 ==========
AUTH_MODE=none                  # none | api_key | jwt
API_KEYS=                       # 逗号分隔, 如: key1,key2
JWT_SECRET=
JWT_ALGORITHM=HS256

# ========== 速率限制 ==========
RATE_LIMIT_GLOBAL_RPM=6000
RATE_LIMIT_USER_RPM=60
RATE_LIMIT_IP_RPM=30

# ========== S3 冷存储 ==========
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=friday-cold
S3_REGION=us-east-1
S3_USE_LOCAL_FS=true
S3_LOCAL_PATH=data/cold
